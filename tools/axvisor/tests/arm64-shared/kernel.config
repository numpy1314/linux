# Minimal homogeneous QEMU VHE host; native KVM must remain disabled.
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_KVM is not set
# CONFIG_ARM64_PSEUDO_NMI is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_POE is not set
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_PREEMPT_NONE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_GENERIC_CLOCKEVENTS=y
CONFIG_POSIX_TIMERS=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_VIRT_DRIVERS=y
CONFIG_AXVISOR_LINUX_BRIDGE=y
CONFIG_AXVISOR_LINUX_CONTROL=y
CONFIG_AXVISOR_ARM64_VHE=y
# CONFIG_AXVISOR_LINUX_CONFORMANCE is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_WERROR is not set
